# BotFather token. Never commit the real .env file.
BOT_TOKEN=
# Numeric Telegram user IDs, separated by commas. Not the bot ID.
ROOT_TELEGRAM_IDS=
# Use a randomly generated hexadecimal password (no URL-reserved characters).
POSTGRES_PASSWORD=
DEV_AUTH=false
PORT=8080
# Public HTTPS URL and hostname after provisioning a server/domain.
APP_URL=https://labturn.example.com
PUBLIC_HOST=labturn.example.com
